# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.m text eol=lf
*.h text eol=lf
*.c text eol=lf

# Binary files
*.png binary
*.mat binary
*.mlapp binary
*.slx binary
*.zip binary
